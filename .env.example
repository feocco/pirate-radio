SERVICE_PORT=8123
SERVICE_HOST=0.0.0.0
HOST_BIND_ADDR=127.0.0.1
PIRATE_RADIO_PUBLIC_URL=https://pirate-radio.example.ts.net
PIRATE_RADIO_LIBRARY_DIR=/data/library
PIRATE_RADIO_STATE_PATH=/data/state.json
PIRATE_RADIO_FEED_URL=https://piratewires.substack.com/feed.xml
PIRATE_RADIO_POLL_INTERVAL_MS=900000
PIRATE_RADIO_MAX_NOTIFICATIONS_PER_POLL=1
PIRATE_RADIO_ENABLE_ALIGNMENT=false
DATABASE_URL=postgres://pirate_radio:replace-with-runtime-secret@pirate-radio-postgres:5432/pirate_radio
PIRATE_RADIO_OIDC_ISSUER=https://auth.example.com/application/o/pirate-radio/
PIRATE_RADIO_OIDC_CLIENT_ID=replace-with-runtime-client-id
PIRATE_RADIO_OIDC_CLIENT_SECRET=replace-with-runtime-client-secret
PIRATE_RADIO_OIDC_SCOPES=openid profile email groups
PIRATE_RADIO_MEMBER_GROUP=pirate-radio-users
PIRATE_RADIO_ADMIN_GROUP=pirate-radio-admins
PIRATE_RADIO_SESSION_HOURS=24
PWR_HEADLESS=true
PWR_PROFILE_DIR=/data/playwright-profile
HOMELAB_FUNCTIONS_URL=http://host.docker.internal:8091
HOMELAB_FUNCTIONS_TOKEN=replace-with-runtime-secret
HA_URL=http://homeassistant.local:8123
HA_LONG_LIVED_TOKEN=replace-with-runtime-secret
OPENAI_API_KEY=replace-with-runtime-secret
