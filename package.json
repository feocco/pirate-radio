{
  "name": "pirate-radio",
  "version": "0.1.0",
  "description": "Private multi-source audio reader and text-to-speech service.",
  "private": true,
  "type": "module",
  "bin": {
    "pirate-radio": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "prebuild": "tsx scripts/parsers/generate-registry.ts",
    "cli": "tsx src/cli.ts",
    "dev": "bash scripts/dev/up.sh",
    "qa": "npm run build && playwright test -c tests/qa",
    "start": "node dist/src/cli.js serve",
    "pretest": "tsx scripts/parsers/generate-registry.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.31",
    "@playwright/test": "^1.60.0",
    "commander": "^14.0.2",
    "css-select": "^7.0.0",
    "css-what": "^8.0.0",
    "domhandler": "^6.0.1",
    "domutils": "^4.0.2",
    "htmlparser2": "^12.0.0",
    "music-metadata": "^12.3.5",
    "openid-client": "^6.8.4",
    "pg": "^8.22.0",
    "playwright": "^1.60.0",
    "shikwasa": "2.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
}
